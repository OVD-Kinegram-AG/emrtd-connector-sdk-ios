:"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EmrtdConnector"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Modern iOS SDK for KINEGRAM eMRTD verification using the v2 WebSocket protocol.","type":"text"}]},{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"The eMRTD Connector enables your iOS app to read and verify electronic passports and ID cards (eMRTDs) through the ","type":"text"},{"identifier":"https:\/\/docs.kinegram.digital\/mobile-chip-sdk\/online\/docval-service\/","isActive":true,"type":"reference"},{"text":". This SDK implements a “fat client” architecture that performs most processing locally while maintaining server-side security validation.","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["    ┌───────────────┐     Results     ┌─────────────────┐","    │ DocVal Server │────────────────▶│   Your Server   │","    └───────────────┘                 └─────────────────┘","            ▲","            │ WebSocket v2","            ▼","┏━━━━━━━━━━━━━━━━━━━━━━━━┓","┃                        ┃","┃  eMRTD Connector       ┃","┃                        ┃","┗━━━━━━━━━━━━━━━━━━━━━━━━┛","            ▲","            │ NFC","            ▼","    ┌──────────────┐","    │              │","    │   PASSPORT   │","    │              │","    │   ID CARD    │","    │              │","    │              │","    │   (eMRTD)    │","    │              │","    └──────────────┘"]},{"level":2,"type":"heading","anchor":"Why-V2","text":"Why V2?"},{"inlineContent":[{"type":"text","text":"V2 solves the iOS 20-second NFC timeout issue by moving most APDU exchanges to the device. Instead of relaying every APDU through the server (causing latency to accumulate), V2 performs bulk reading locally and uses the server only for security-critical operations."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Quick-Start","text":"Quick Start"},{"syntax":"swift","type":"codeListing","code":["import KinegramEmrtdConnector","","\/\/ Initialize the connector","let connector = EmrtdConnector(","    serverURL: URL(string: \"wss:\/\/server.example.com\/ws2\/validate\")!,","    validationId: UUID().uuidString,","    clientId: \"YOUR-CLIENT-ID\"",")","","\/\/ Simple one-call validation","let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900101\",","    expiryDateyyMMdd: \"250101\"",")","","let result = try await connector.validate(with: mrzKey)","","if result.isValid {","    print(\"Document holder: \\(result.mrzInfo?.primaryIdentifier ?? \"\")\")","}"]},{"level":2,"type":"heading","anchor":"Automatic-PACE-Selection","text":"Automatic PACE Selection"},{"inlineContent":[{"text":"If you provide the document type and issuing country, the SDK decides whether to enable PACE polling automatically.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Auto-select PACE polling for FRA ID card","let canKey = CANKey(can: \"123456\")","let result = try await connector.validate(","    with: canKey,","    documentType: .idCard,","    issuingCountry: \"FRA\" \/\/ ISO 3166-1 alpha-3",")"]},{"inlineContent":[{"type":"text","text":"You can also derive the document type directly from the MRZ document code prefix:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ \"ID\" or \"I<\" -> .idCard; otherwise .passport (e.g., \"P<\", \"PM\")","let docType = DocumentKind.fromMRZDocumentCode(\"ID\")","let result2 = try await connector.validate(","    with: canKey,","    documentType: docType,","    issuingCountry: \"FRA\"",")"]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.kinegram.ios.emrtdconnector/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/s9EscapableP"},"doc: