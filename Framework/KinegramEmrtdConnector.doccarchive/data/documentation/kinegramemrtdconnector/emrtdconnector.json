{"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/MonitoringDelegate","doc:\/\/com.kinegram.ios.emrtdconnector\/s8CopyableP","doc:\/\/com.kinegram.ios.emrtdconnector\/s9EscapableP"],"title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EmrtdConnector","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Modern iOS SDK for KINEGRAM eMRTD verification using the v2 WebSocket protocol."}],"type":"paragraph"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The eMRTD Connector enables your iOS app to read and verify electronic passports and ID cards (eMRTDs) through the ","type":"text"},{"identifier":"https:\/\/docs.kinegram.digital\/mobile-chip-sdk\/online\/docval-service\/","isActive":true,"type":"reference"},{"text":". This SDK implements a “fat client” architecture that performs most processing locally while maintaining server-side security validation.","type":"text"}],"type":"paragraph"},{"code":["    ┌───────────────┐     Results     ┌─────────────────┐","    │ DocVal Server │────────────────▶│   Your Server   │","    └───────────────┘                 └─────────────────┘","            ▲","            │ WebSocket v2","            ▼","┏━━━━━━━━━━━━━━━━━━━━━━━━┓","┃                        ┃","┃  eMRTD Connector       ┃","┃                        ┃","┗━━━━━━━━━━━━━━━━━━━━━━━━┛","            ▲","            │ NFC","            ▼","    ┌──────────────┐","    │              │","    │   PASSPORT   │","    │              │","    │   ID CARD    │","    │              │","    │              │","    │   (eMRTD)    │","    │              │","    └──────────────┘"],"type":"codeListing","syntax":null},{"type":"heading","anchor":"Why-V2","text":"Why V2?","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"V2 solves the iOS 20-second NFC timeout issue by moving most APDU exchanges to the device. Instead of relaying every APDU through the server (causing latency to accumulate), V2 performs bulk reading locally and uses the server only for security-critical operations."}]},{"type":"heading","anchor":"Quick-Start","text":"Quick Start","level":2},{"code":["import KinegramEmrtdConnector","","\/\/ Initialize the connector","let connector = EmrtdConnector(","    serverURL: URL(string: \"wss:\/\/server.example.com\/ws2\/validate\")!,","    validationId: UUID().uuidString,","    clientId: \"YOUR-CLIENT-ID\"",")","","\/\/ Simple one-call validation","let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900101\",","    expiryDateyyMMdd: \"250101\"",")","","let result = try await connector.validate(with: mrzKey)","","if result.isValid {","    print(\"Document holder: \\(result.mrzInfo?.primaryIdentifier ?? \"\")\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Automatic-PACE-Selection","level":2,"text":"Automatic PACE Selection","type":"heading"},{"inlineContent":[{"type":"text","text":"If you provide the document type and issuing country, the SDK decides whether to enable PACE polling automatically."}],"type":"paragraph"},{"code":["\/\/ Auto-select PACE polling for FRA ID card","let canKey = CANKey(can: \"123456\")","let result = try await connector.validate(","    with: canKey,","    documentType: .idCard,","    issuingCountry: \"FRA\" \/\/ ISO 3166-1 alpha-3",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also derive the document type directly from the MRZ document code prefix:"}],"type":"paragraph"},{"code":["\/\/ \"ID\" or \"I<\" -> .idCard; otherwise .passport (e.g., \"P<\", \"PM\")","let docType = DocumentKind.fromMRZDocumentCode(\"ID\")","let result2 = try await connector.validate(","    with: canKey,","    documentType: docType,","    issuingCountry: \"FRA\"",")"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/init(serverURL:validationId:clientId:httpHeaders:baggage:enableDiagnostics:receiveResult:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/delegate","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/isConnected","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/monitoringDelegate","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/nfcStatusLocalization"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/connect()","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/connectWithRetry()","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/disconnect()","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/startValidation(accessKey:documentType:issuingCountry:)","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector\/startValidation(accessKey:filesToRead:documentType:issuingCountry:)","doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdCo