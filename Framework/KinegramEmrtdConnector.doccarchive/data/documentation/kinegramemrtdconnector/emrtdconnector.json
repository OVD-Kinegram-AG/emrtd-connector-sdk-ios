{"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"KinegramEmrtdConnector"}],"role":"symbol","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EmrtdConnector","kind":"identifier"}],"externalID":"s:22KinegramEmrtdConnector0bC0C","title":"EmrtdConnector","symbolKind":"class","navigatorTitle":[{"text":"EmrtdConnector","kind":"identifier"}]},"identifier":{"url":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/EmrtdConnector","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/MonitoringDelegate","doc:\/\/com.kinegram.ios.emrtdconnector\/s8CopyableP","doc:\/\/com.kinegram.ios.emrtdconnector\/s9EscapableP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EmrtdConnector","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern iOS SDK for KINEGRAM eMRTD verification using the v2 WebSocket protocol."}]},{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eMRTD Connector enables your iOS app to read and verify electronic passports and ID cards (eMRTDs) through the "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.kinegram.digital\/mobile-chip-sdk\/online\/docval-service\/"},{"type":"text","text":". This SDK implements a “fat client” architecture that performs most processing locally while maintaining server-side security validation."}]},{"syntax":null,"type":"codeListing","code":["    ┌───────────────┐     Results     ┌─────────────────┐","    │ DocVal Server │────────────────▶│   Your Server   │","    └───────────────┘                 └─────────────────┘","            ▲","            │ WebSocket v2","            ▼","┏━━━━━━━━━━━━━━━━━━━━━━━━┓","┃                        ┃","┃  eMRTD Connector       ┃","┃                        ┃","┗━━━━━━━━━━━━━━━━━━━━━━━━┛","            ▲","            │ NFC","            ▼","    ┌──────────────┐","    │              │","    │   PASSPORT   │","    │              │","    │   ID CARD    │","    │              │","    │              │","    │   (eMRTD)    │","    │              │","    └──────────────┘"]},{"text":"Why V2?","level":2,"type":"heading","anchor":"Why-V2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"V2 solves the iOS 20-second NFC timeout issue by moving most APDU exchanges to the device. Instead of relaying every APDU through the server (causing latency to accumulate), V2 performs bulk reading locally and uses the server only for security-critical operations."}]},{"text":"Quick Start","level":2,"type":"heading","anchor":"Quick-Start"},{"syntax":"swift","type":"codeListing","code":["import KinegramEmrtdConnector","","\/\/ Initialize the connector","let connector = EmrtdConnector(","    serverURL: URL(string: \"wss:\/\/server.example.com\/ws2\/validate\")!,","    validationId: UUID().uuidString,","    clientId: \"YOUR-CLIENT-ID\"",")","","\/\/ Simple one-call validation","let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900101\",","    expiryDateyyMMdd: \"250101\"",")","","let result = try await connector.validate(with: mrzKey)","","if result.isValid {","    print(\"Document holder: \\(result.mrzInfo?.primaryIdentifier ?? \"\")\")","}"]},{"text":"Automatic PACE Selection","level":2,"type":"heading","anchor":"Automatic-PACE-Selection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you provide the document type and issuing country, the SDK decides whether to enable PACE polling automati