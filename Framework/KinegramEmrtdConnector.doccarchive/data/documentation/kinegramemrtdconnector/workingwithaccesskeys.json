{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To access an eMRTD chip, you need to provide authentication credentials. The SDK supports two types of access keys:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MRZ Key"}]},{"text":": Using document number, date of birth, and date of expiry from the Machine Readable Zone","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CAN Key","type":"text"}]},{"type":"text","text":": Using the Card Access Number printed on the document"}]}]}],"type":"unorderedList"},{"text":"MRZ Key","level":2,"anchor":"MRZ-Key","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The MRZ (Machine Readable Zone) contains the document information printed at the bottom of passports and ID cards."}]},{"text":"Creating an MRZ Key","level":3,"anchor":"Creating-an-MRZ-Key","type":"heading"},{"code":["let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900515\",    \/\/ Format: yyMMdd","    expiryDateyyMMdd: \"251231\"    \/\/ Format: yyMMdd",")"],"syntax":"swift","type":"codeListing"},{"text":"Date Format","level":3,"anchor":"Date-Format","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dates must be provided in "},{"code":"yyMMdd","type":"codeVoice"},{"type":"text","text":" format:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"900515\""},{"text":" = May 15, 1990","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"251231\""},{"type":"text","text":" = December 31, 2025"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"010101\""},{"type":"text","text":" = January 1, 2001"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Document-Number","type":"heading","level":3,"text":"Document Number"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The document number should be provided exactly as it appears in the MRZ:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Remove any spaces"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Include check digits if present"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum 9 characters"}]}]}]},{"anchor":"Example-from-MRZ","type":"heading","level":3,"text":"Example from MRZ"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given this MRZ:"}]},{"syntax":null,"type":"codeListing","code":["P<UTOERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<","L898902C36UTO7408122F1204159ZE184226B<<<<<10"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extract:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Document Number: ","type":"text"},{"code":"L898902C3","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Birth Date: "},{"code":"740812","type":"codeVoice"},{"text":" (August 12, 1974)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry Date: "},{"code":"120415","type":"codeVoice"},{"type":"text","text":" (April 15, 2012)"}]}]}]},{"text":"CAN Key","level":2,"type":"heading","anchor":"CAN-Key"},{"type":"paragraph","inlineContent":[{"text":"The CAN (Card Access Number) is a 6-digit number printed on the document, typically on the front of ID cards.","type":"text"}]},{"text":"Creating a CAN Key","level":3,"type":"heading","anchor":"Creating-a-CAN-Key"},{"type":"codeListing","code":["let canKey = CANKey(can: \"123456\")"],"syntax":"swift"},{"text":"CAN Format","level":3,"type":"heading","anchor":"CAN-Format"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Exactly 6 digits","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"No spaces or separators","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Usually printed near the document number","type":"text"}]}]}],"type":"unorderedList"},{"text":"Choosing Between MRZ and CAN","level":2,"type":"heading","anchor":"Choosing-Between-MRZ-and-CAN"},{"text":"Use MRZ when:","level":3,"type":"heading","anchor":"Use-MRZ-when"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Working with passports (always have MRZ)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have OCR capabilities to read the MRZ"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Users are familiar with their document details","type":"text"}]}]}],"type":"unorderedList"},{"text":"Use CAN when:","level":3,"type":"heading","anchor":"Use-CAN-when"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Working with ID cards that have CAN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want a simpler user experience (just 6 digits)"}]}]},{"content":[{"inlineContent":[{"text":"The CAN is clearly visible on the document","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Access Control Protocols","level":2,"anchor":"Access-Control-Protocols"},{"type":"paragraph","inlineContent":[{"text":"The SDK automatically selects the appropriate access control protocol:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"BAC","type":"text"}],"type":"strong"},{"type":"text","text":" (Basic Access Control): Older passports"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"PACE","type":"text"}]},{"type":"text","text":" (Password Authenticated Connection Establishment): Newer passports and ID cards"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Both MRZ and CAN keys can use either protocol - the SDK handles this automatically.","type":"text"}]},{"type":"heading","text":"Usage Example","level":2,"anchor":"Usage-Example"},{"type":"codeListing","code":["\/\/ Using MRZ","let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900101\",","    expiryDateyyMMdd: \"250101\"",")","","let result = try await connector.validate(with: mrzKey)","","\/\/ Using CAN","let canKey = CANKey(can: \"123456\")","let result = try await connector.validate(with: canKey)"],"syntax":"swift"},{"type":"heading","text":"Error Handling","level":2,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Common access key errors:"}]},{"type":"codeListing","code":["do {","    let result = try await connector.validate(with: accessKey)","} catch EmrtdReaderError.accessControlFailed {","    \/\/ Wrong access key - check MRZ\/CAN values","} catch EmrtdReaderError.invalidAccessKey {","    \/\/ Malformed access key","} catch {","    \/\/ Other errors","}"],"syntax":"swift"},{"type":"heading","text":"Security Considerations","level":2,"anchor":"Security-Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never log or store access keys in plain text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Access keys are sensitive personal data","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clear from memory after use","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use secure input methods in your UI"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"metadata":{"role":"article","title":"Working with Access Keys","modules":[{"name":"KinegramEmrtdConnector"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/kinegramemrtdconnector\/workingwithaccesskeys"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector"]]},"identifier":{"url":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/WorkingWithAccessKeys","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Learn how to use MRZ and CAN access keys to read eMRTD documents."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"article","references":{"doc://com.kinegram.ios.emrtdconnector/documentation/KinegramEmrtdConnector":{"kind":"symbol","role":"collection","title":"KinegramEmrtdConnector","type":"topic","abstract":[],"url":"\/documentation\/kinegramemrtdconnector","identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector"}}}