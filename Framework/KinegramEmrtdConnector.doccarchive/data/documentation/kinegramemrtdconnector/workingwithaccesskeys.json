{"sections":[],"metadata":{"title":"Working with Access Keys","role":"article","modules":[{"name":"KinegramEmrtdConnector"}],"roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/WorkingWithAccessKeys"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"To access an eMRTD chip, you need to provide authentication credentials. The SDK supports two types of access keys:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MRZ Key","type":"text"}]},{"type":"text","text":": Using document number, date of birth, and date of expiry from the Machine Readable Zone"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CAN Key"}]},{"type":"text","text":": Using the Card Access Number printed on the document"}]}]}]},{"anchor":"MRZ-Key","type":"heading","level":2,"text":"MRZ Key"},{"inlineContent":[{"type":"text","text":"The MRZ (Machine Readable Zone) contains the document information printed at the bottom of passports and ID cards."}],"type":"paragraph"},{"anchor":"Creating-an-MRZ-Key","type":"heading","level":3,"text":"Creating an MRZ Key"},{"code":["let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900515\",    \/\/ Format: yyMMdd","    expiryDateyyMMdd: \"251231\"    \/\/ Format: yyMMdd",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Date Format","anchor":"Date-Format"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dates must be provided in "},{"code":"yyMMdd","type":"codeVoice"},{"type":"text","text":" format:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"900515\""},{"type":"text","text":" = May 15, 1990"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"251231\""},{"type":"text","text":" = December 31, 2025"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"010101\""},{"type":"text","text":" = January 1, 2001"}]}]}]},{"type":"heading","level":3,"text":"Document Number","anchor":"Document-Number"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The document number should be provided exactly as it appears in the MRZ:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove any spaces"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Include check digits if present"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum 9 characters"}]}]}]},{"type":"heading","level":3,"text":"Example from MRZ","anchor":"Example-from-MRZ"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given this MRZ:"}]},{"type":"codeListing","syntax":null,"code":["P<UTOERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<","L898902C36UTO7408122F1204159ZE184226B<<<<<10"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extract:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Document Number: "},{"type":"codeVoice","code":"L898902C3"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Birth Date: "},{"type":"codeVoice","code":"740812"},{"type":"text","text":" (August 12, 1974)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry Date: "},{"type":"codeVoice","code":"120415"},{"type":"text","text":" (April 15, 2012)"}]}]}]},{"type":"heading","level":2,"text":"CAN Key","anchor":"CAN-Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CAN (Card Access Number) is a 6-digit number printed on the document, typically on the front of ID cards."}]},{"type":"heading","level":3,"text":"Creating a CAN Key","anchor":"Creating-a-CAN-Key"},{"type":"codeListing","syntax":"swift","code":["let canKey = CANKey(can: \"123456\")"]},{"type":"heading","level":3,"text":"CAN Format","anchor":"CAN-Format"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exactly 6 digits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No spaces or separators"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Usually printed near the document number"}]}]}]},{"type":"heading","level":2,"text":"Choosing Between MRZ and CAN","anchor":"Choosing-Between-MRZ-and-CAN"},{"type":"heading","level":3,"text":"Use MRZ when:","anchor":"Use-MRZ-when"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Working with passports (always have MRZ)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have OCR capabilities to read the MRZ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Users are familiar with their document details","type":"text"}]}]}]},{"type":"heading","text":"Use CAN when:","anchor":"Use-CAN-when","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Working with ID cards that have CAN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want a simpler user experience (just 6 digits)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The CAN is clearly visible on the document"}]}]}]},{"type":"heading","text":"Access Control Protocols","anchor":"Access-Control-Protocols","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK automatically selects the appropriate access control protocol:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"BAC","type":"text"}]},{"type":"text","text":" (Basic Access Control): Older passports"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"PACE","type":"text"}]},{"type":"text","text":" (Password Authenticated Connection Establishment): Newer passports and ID cards"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both MRZ and CAN keys can use either protocol - the SDK handles this automatically."}]},{"type":"heading","text":"Usage Example","anchor":"Usage-Example","level":2},{"type":"codeListing","syntax":"swift","code":["\/\/ Using MRZ","let mrzKey = MRZKey(","    documentNumber: \"P1234567\",","    birthDateyyMMdd: \"900101\",","    expiryDateyyMMdd: \"250101\"",")","","let result = try await connector.validate(with: mrzKey)","","\/\/ Using CAN","let canKey = CANKey(can: \"123456\")","let result = try await connector.validate(with: canKey)"]},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Common access key errors:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let result = try await connector.validate(with: accessKey)","} catch EmrtdReaderError.accessControlFailed {","    \/\/ Wrong access key - check MRZ\/CAN values","} catch EmrtdReaderError.invalidAccessKey {","    \/\/ Malformed access key","} catch {","    \/\/ Other errors","}"]},{"type":"heading","text":"Security Considerations","anchor":"Security-Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never log or store access keys in plain text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Access keys are sensitive personal data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clear from memory after use"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use secure input methods in your UI"}]}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Learn how to use MRZ and CAN access keys to read eMRTD documents."}],"variants":[{"paths":["\/documentation\/kinegramemrtdconnector\/workingwithaccesskeys"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.kinegram.ios.emrtdconnector/documentation/KinegramEmrtdConnector":{"url":"\/documentation\/kinegramemrtdconnector","title":"KinegramEmrtdConnector","identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector","abstract":[],"kind":"symbol","type":"topic","role":"collection"}}}