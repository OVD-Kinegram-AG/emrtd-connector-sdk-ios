s":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verifies data integrity: ensures passport data hasn’t been modified"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Checks the digital signature on the passport data (SOD file)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Uses PKI certificates to validate the issuing country’s signature","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Result: “SUCCEEDED” = data is intact, “FAILED” = data may be tampered"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Chip Authentication (CA)"}]}]},{"items":[{"content":[{"inlineContent":[{"text":"Verifies chip authenticity: ensures the chip is genuine, not cloned","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chip proves it has the private key matching the public key in DG14"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establishes new secure messaging keys for enhanced protection"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result: “SUCCEEDED” = genuine chip, “FAILED” = possible clone"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Active Authentication (AA)"}]}]},{"items":[{"content":[{"inlineContent":[{"text":"Proves the chip is not a copy at this moment","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Chip signs a challenge with its private key (from DG15)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Like asking the chip to solve a unique puzzle only it can solve","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Result: “SUCCEEDED” = original chip responding, “FAILED” = possible replay","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Why All Three?","level":2,"anchor":"Why-All-Three"},{"items":[{"content":[{"inlineContent":[{"text":"PA: Ensures data wasn’t changed (like a tamper-evident seal)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"CA: Ensures chip is genuine (like a hologram)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"AA: Ensures chip is responding live (like a live video call vs recording)","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/kinegramemrtdconnector\/validationresult"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.kinegram.ios.emrtdconnector/documentation/KinegramEmrtdConnector":{"abstract":[],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/kinegramemrtdconnector","identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector","title":"KinegramEmrtdConnector"},"doc://com.kinegram.ios.emrtdconnector/documentation/KinegramEmrtdConnector/ValidationResult/additionalDocumentDetails":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"additionalDocumentDetails","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AdditionalDocumentDetails","kind":"typeIdentifier","preciseIdentifier":"s:22KinegramEmrtdConnector25AdditionalDocumentDetailsV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/ValidationResult\/additionalDocumentDetails","title":"additionalDocumentDetails","abstract":[],"url":"\/documentation\/kinegramemrtdconnector\/validationresult\/additionaldocumentdetails","role":"symbol","kind":"symbol"},"doc://com.kinegram.ios.emrtdconnector/documentation/KinegramEmrtdConnector/ValidationResult/errors":{"identifier":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnec