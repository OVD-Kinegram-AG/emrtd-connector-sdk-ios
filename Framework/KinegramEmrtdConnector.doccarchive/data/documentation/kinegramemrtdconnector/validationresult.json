{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.kinegram.ios.emrtdconnector\/Se","doc:\/\/com.kinegram.ios.emrtdconnector\/SE"],"type":"conformsTo"}],"abstract":[{"text":"The final validation result from the server","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationResult","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This contains all passport data and the results of the three authentication protocols:","type":"text"}]},{"type":"heading","text":"Authentication Protocols Explained","anchor":"Authentication-Protocols-Explained","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Passive Authentication (PA)"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verifies data integrity: ensures passport data hasn’t been modified","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Checks the digital signature on the passport data (SOD file)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Uses PKI certificates to validate the issuing country’s signature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Result: “SUCCEEDED” = data is intact, “FAILED” = data may be tampered"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Chip Authentication (CA)"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verifies chip authenticity: ensures the chip is genuine, not cloned"}]}]},{"content":[{"inlineContent":[{"text":"Chip proves it has the private key matching the public key in DG14","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes new secure messaging keys for enhanced protection","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result: “SUCCEEDED” = genuine chip, “FAILED” = possible clone"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Active Authentication (AA)","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Proves the chip is not a copy at this moment","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Chip signs a challenge with its private key (from DG15)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Like asking the chip to solve a unique puzzle only it can solve","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result: “SUCCEEDED” = original chip responding, “FAILED” = possible replay"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Why-All-Three","type":"heading","text":"Why All Three?"},{"items":[{"content":[{"inlineContent":[{"text":"PA: Ensures data wasn’t changed (like a tamper-evident seal)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"CA: Ensures chip is genuine (like a hologram)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"AA: Ensures chip is responding live (like a live video call vs recording)","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.kinegram.ios.emrtdconnector\/documentation\/KinegramEmrtdConnector\/ValidationResult","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/kinegramemrtdconnector\/validationresult"]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"